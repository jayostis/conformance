@prefix clinical: <https://ns.cascadeprotocol.org/clinical/v1#> .
@prefix cascade: <https://ns.cascadeprotocol.org/core/v1#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<urn:cascade:medication:example-ai>
    a clinical:Medication ;
    clinical:drugName "Metformin" ;
    cascade:dataProvenance cascade:AIExtracted ;
    cascade:schemaVersion "1.3" ;
    prov:wasGeneratedBy <urn:cascade:activity:extraction-1> .

<urn:cascade:activity:extraction-1>
    a cascade:AIExtractionActivity ;
    cascade:extractionConfidence "0.91"^^xsd:decimal ;
    cascade:extractionModel "qwen3.5-4b-q4_k_m" ;
    cascade:sourceNarrativeSection "medications" ;
    cascade:requiresUserReview "false"^^xsd:boolean .
