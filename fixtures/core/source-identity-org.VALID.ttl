# core v3.5 — ORIGIN axis, org: tier.
#
# The producer derived a real organization, so the identity carries the org:
# scheme and a normalized slug. The three axes are all present and all say
# different things: the ORIGIN is org:meridian, the display LABEL is the
# organization as the source worded it, and the INGESTION batch is the export
# the record arrived in.
#
# Fully synthetic: invented organization, endpoint, person and values.

@prefix cascade: <https://ns.cascadeprotocol.org/core/v1#> .
@prefix clinical: <https://ns.cascadeprotocol.org/clinical/v1#> .
@prefix health: <https://ns.cascadeprotocol.org/health/v1#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:uuid:5c1de001-0000-4000-8000-000000000001> a health:LabResultRecord ;
    health:testName "Hemoglobin A1c" ;
    health:resultValue "7.4" ;
    health:resultUnit "%" ;
    health:performedDate "2031-02-11"^^xsd:date ;
    cascade:dataProvenance cascade:ClinicalGenerated ;
    cascade:schemaVersion "1.3" ;
    cascade:sourceIdentity "org:meridian" ;
    clinical:sourceEHR "Meridian Health System" ;
    cascade:sourceSystem "Household export" .
