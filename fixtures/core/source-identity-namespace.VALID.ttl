# core v3.5 — ORIGIN axis, ns: tier.
#
# Nothing in the source document named or located an organization, but the
# record's identifiers do have an assigning authority: here the OID root of the
# C-CDA <id> the observation carried. The identity says so, honestly, with the
# ns: scheme. Two records agree on origin only if they agree on the namespace.
#
# Fully synthetic: the OID is under the HL7 example arc.

@prefix cascade: <https://ns.cascadeprotocol.org/core/v1#> .
@prefix health: <https://ns.cascadeprotocol.org/health/v1#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:uuid:5c1de001-0000-4000-8000-000000000002> a health:LabResultRecord ;
    health:testName "Sodium" ;
    health:resultValue "139" ;
    health:resultUnit "mmol/L" ;
    health:performedDate "2031-04-06"^^xsd:date ;
    cascade:dataProvenance cascade:ClinicalGenerated ;
    cascade:schemaVersion "1.3" ;
    cascade:sourceIdentity "ns:2.16.840.1.113883.19.5.99992.1" ;
    cascade:sourceRecordId "2.16.840.1.113883.19.5.99992.5:SYN-OBS-NA" .
