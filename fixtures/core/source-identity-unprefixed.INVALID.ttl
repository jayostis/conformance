# core v3.5 — NEGATIVE. An unprefixed value in the ORIGIN axis.
#
# The producer wrote the display label straight into cascade:sourceIdentity. It
# carries no scheme, so a consumer cannot tell whether an organization was
# derived, an assigning authority was, or nothing was — which is precisely the
# confusion the scheme prefix exists to end. cascade:SourceIdentityShape rejects
# it on sh:pattern.
#
# This is the mistake worth catching, because the value LOOKS informative. The
# same shape rejects an import-batch label written here for the same reason.
#
# Fully synthetic.

@prefix cascade: <https://ns.cascadeprotocol.org/core/v1#> .
@prefix clinical: <https://ns.cascadeprotocol.org/clinical/v1#> .
@prefix health: <https://ns.cascadeprotocol.org/health/v1#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:uuid:5c1de001-0000-4000-8000-000000000004> a health:LabResultRecord ;
    health:testName "Potassium" ;
    health:resultValue "4.2" ;
    health:resultUnit "mmol/L" ;
    health:performedDate "2031-04-06"^^xsd:date ;
    cascade:dataProvenance cascade:ClinicalGenerated ;
    cascade:schemaVersion "1.3" ;
    cascade:sourceIdentity "Meridian Health System" ;
    clinical:sourceEHR "Meridian Health System" .
