# core v3.5 — ORIGIN axis, transport: tier (the honest last resort).
#
# The document named no organization, located none, and carried no assigning
# authority: every reference in it was a urn:uuid. The producer must not invent
# an origin, so it restates the ingestion label under the transport: scheme.
#
# The prefix is the whole point. A consumer reading transport: knows the origin
# is UNKNOWN, and must not read two matching transport: values as evidence that
# two records share a source — one import batch routinely carries several
# organizations.
#
# Fully synthetic.

@prefix cascade: <https://ns.cascadeprotocol.org/core/v1#> .
@prefix health: <https://ns.cascadeprotocol.org/health/v1#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:uuid:5c1de001-0000-4000-8000-000000000003> a health:LabResultRecord ;
    health:testName "Albumin" ;
    health:resultValue "4.1" ;
    health:resultUnit "g/dL" ;
    health:performedDate "2031-05-20"^^xsd:date ;
    cascade:dataProvenance cascade:ClinicalGenerated ;
    cascade:schemaVersion "1.3" ;
    cascade:sourceIdentity "transport:Household export" ;
    cascade:sourceSystem "Household export" .
