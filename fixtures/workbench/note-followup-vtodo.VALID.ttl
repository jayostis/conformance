# NOTES-SUBSTRATE POSITIVE FIXTURE: this file MUST pass `cascade validate`.
#
# A follow-up / open loop (oa:motivatedBy workbench:followUp), dual-typed
# cal:Vtodo, carrying the required RFC 5545 ical:status plus an optional
# ical:due. Exercises FollowUpShape (followUp requires an ical:status in the
# VTODO enum) alongside the base WebAnnotationShape. workbench v1-draft.0.5.

@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix ical: <http://www.w3.org/2002/12/cal/ical#> .
@prefix cal:  <http://www.w3.org/2002/12/cal/ical#> .
@prefix workbench: <https://ns.cascadeprotocol.org/workbench/v1#> .

<urn:cascade:note-2> a oa:Annotation , cal:Vtodo ;
    oa:motivatedBy workbench:followUp ;
    oa:hasBody [ a oa:TextualBody ; rdf:value "Recheck TSH in 3 months." ] ;
    oa:hasTarget <urn:cascade:observation-tsh> ;
    ical:status "NEEDS-ACTION" ;
    ical:due "2026-10-15"^^xsd:date ;
    prov:wasAttributedTo <urn:cascade:agent-caregiver> ;
    prov:generatedAtTime "2026-07-15T09:00:00Z"^^xsd:dateTime .
