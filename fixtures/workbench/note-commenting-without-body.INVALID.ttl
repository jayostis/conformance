# NOTES-SUBSTRATE NEGATIVE FIXTURE: this file MUST fail `cascade validate`.
#
# A caregiver note (oa:motivatedBy oa:commenting) with NO body. A commenting
# note must actually say something; CommentingBodyShape requires an oa:hasBody
# when the motivation is oa:commenting. This file MUST violate
# CommentingBodyShape. workbench v1-draft.0.5.

@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<urn:cascade:bad-comment> a oa:Annotation ;
    oa:motivatedBy oa:commenting ;
    oa:hasTarget <urn:cascade:condition-hypertension> ;
    prov:wasAttributedTo <urn:cascade:agent-caregiver> ;
    prov:generatedAtTime "2026-07-15T09:00:00Z"^^xsd:dateTime .
