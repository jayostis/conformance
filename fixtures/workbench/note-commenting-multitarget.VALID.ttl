# NOTES-SUBSTRATE POSITIVE FIXTURE: this file MUST pass `cascade validate`.
#
# A caregiver note (oa:motivatedBy oa:commenting) over TWO targets, with an
# oa:TextualBody and required PROV-O attribution. Exercises WebAnnotationShape
# (>= 1 target, motivation, attribution + xsd:dateTime timestamp) and
# CommentingBodyShape (a commenting note must carry a body). workbench v1-draft.0.5.

@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<urn:cascade:note-1> a oa:Annotation ;
    oa:motivatedBy oa:commenting ;
    oa:hasBody [ a oa:TextualBody ; rdf:value "More tired than usual this week." ] ;
    oa:hasTarget <urn:cascade:observation-lipid-panel> , <urn:cascade:condition-hypertension> ;
    prov:wasAttributedTo <urn:cascade:agent-caregiver> ;
    prov:generatedAtTime "2026-07-10T14:30:00Z"^^xsd:dateTime .
