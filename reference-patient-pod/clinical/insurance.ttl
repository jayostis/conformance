@prefix cascade: <https://ns.cascadeprotocol.org/core/v1#> .
@prefix clinical: <https://ns.cascadeprotocol.org/clinical/v1#> .
@prefix coverage: <https://ns.cascadeprotocol.org/coverage/v1#> .
@prefix fhir: <http://hl7.org/fhir/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# =============================================================================
# Insurance / Coverage — Alex Rivera
# =============================================================================
# 1 active insurance coverage record.
# Schema Version: 1.3
# Provenance: ClinicalGenerated (from EHR import)
# =============================================================================

# Coverage 1: Blue Cross Blue Shield PPO
#
# Typed coverage:InsurancePlan and written with coverage: properties. The
# clinical:CoverageRecord class this record previously used has been deprecated
# since clinical v1.5 in favour of coverage:InsurancePlan, and no SHACL shape
# ever targeted it, so the record validated vacuously. It is now checked by
# coverage:InsurancePlanShape.
<urn:uuid:c0vr-0001-aaaa-bbbb-ccccddddeeee> a coverage:InsurancePlan ;
    coverage:providerName "Blue Cross Blue Shield" ;
    coverage:memberId "BCBS-AR-2020-78452" ;
    cascade:dataProvenance cascade:ClinicalGenerated ;
    cascade:schemaVersion "1.3" ;
    coverage:groupNumber "GRP-98765" ;
    coverage:planName "Blue PPO Select" ;
    coverage:planType "ppo" ;
    coverage:coverageType "primary" ;
    coverage:subscriberRelationship "self" ;
    # coverage:effectiveStart is xsd:date, not the xsd:dateTime that
    # clinical:effectivePeriodStart carried. The time component was a midnight-UTC
    # placeholder and holds no information, so the date is the faithful value.
    coverage:effectiveStart "2020-01-01"^^xsd:date ;
    # coverage v1.3 has no payor property distinct from coverage:providerName
    # (which it maps to fhir:Coverage.payor), and providerName is sh:maxCount 1,
    # so this assertion is retained under its original predicate rather than
    # dropped or folded into providerName.
    clinical:payorName "Blue Cross Blue Shield of Oregon" ;
    coverage:subscriberId "BCBS-AR-2020-78452" ;
    coverage:sourceRecordId "ehr-coverage-2020-0101-001" .
