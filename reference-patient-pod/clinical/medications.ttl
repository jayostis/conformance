# Medication 7: Potassium Supplement 20mEq daily — INTERACTION WITH LISINOPRIL
# ============================================================================
# WARNING: This supplement interacts with Lisinopril (Medication #1).
# ACE inhibitors like lisinopril reduce aldosterone secretion, which decreases
# renal potassium excretion. Combined with supplemental potassium, this can
# lead to hyperkalemia (elevated serum potassium). See lab-results.ttl for
# Alex's borderline-high potassium of 5.1 mEq/L, supporting this scenario.
# ============================================================================
<urn:uuid:med0-0007-aaaa-bbbb-ccccddddeeee> a clinical:Medication ;
    clinical:drugName "Potassium Chloride" ;
    clinical:status "active" ;
    cascade:dataProvenance cascade:SelfReported ;
    cascade:schemaVersion "1.3" ;
    clinical:dosage "20 mEq" ;
    clinical:frequency "once daily" ;
    clinical:route "oral" ;
    clinical:startDate "2025-08-01T00:00:00Z"^^xsd:dateTime ;
    clinical:notes "Self-initiated potassium supplement. POTENTIAL INTERACTION: Concurrent use with lisinopril (ACE inhibitor) increases risk of hyperkalemia. Latest serum K+ is 5.1 mEq/L (borderline high)." ;
    clinical:provenanceClass "userTracked" ;
    clinical:indication "Muscle cramps" ;
    clinical:medicationForm "tablet" ;
    clinical:activeIngredient "Potassium Chloride" ;
    clinical:ingredientStrength "20 mEq" .

