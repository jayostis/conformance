        [ a health:DailySleepSnapshot ; cascade:date "2026-01-20T00:00:00Z"^^xsd:dateTime ; health:durationHours "7.2"^^xsd:decimal ; health:sleepQuality health:Good ; prov:wasGeneratedBy [ a prov:Activity ; cascade:sourceType "healthKit" ; prov:label "Apple Watch Series 9" ] ]
