@prefix cascade: <https://ns.cascadeprotocol.org/core/v1#> .
@prefix health: <https://ns.cascadeprotocol.org/health/v1#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# =============================================================================
# Sleep Data — Alex Rivera
# =============================================================================
# 30 days of sleep tracking from Apple Watch (2026-01-20 to 2026-02-18).
# Duration: 5.5-8.5 hours/night with realistic weekly patterns.
# Quality: fair to good (typical for a 52-year-old with managed conditions).
# Provenance: DeviceGenerated (Apple Watch Series 9 via HealthKit)
# =============================================================================

<#sleep> a health:SleepData ;
