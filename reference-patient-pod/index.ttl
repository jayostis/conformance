@prefix ldp: <http://www.w3.org/ns/ldp#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix cascade: <https://ns.cascadeprotocol.org/core/v1#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
# Root LDP Container — Alex Rivera Reference Patient Pod
# =============================================================================
# This is the root index of the reference patient pod, structured as an LDP
# Basic Container per Solid Protocol conventions. It enumerates every resource
# in the pod for discoverability by agents and applications.
# =============================================================================

<> a ldp:BasicContainer ;
    dcterms:title "Alex Rivera — Cascade Reference Patient Pod" ;
    dcterms:description "A complete synthetic patient pod demonstrating all Cascade Protocol data types, provenance layers, and cross-domain interaction scenarios." ;
    dcterms:created "2026-02-19T00:00:00Z"^^xsd:dateTime ;
    cascade:schemaVersion "1.3" ;

    # ── Profile & Settings ──────────────────────────────────────────────────
    ldp:contains
        <profile/card.ttl> ,
        <settings/publicTypeIndex.ttl> ,
        <settings/privateTypeIndex.ttl> ,

    # ── Clinical Records (EHR-sourced, ClinicalGenerated provenance) ───────
        <clinical/patient-profile.ttl> ,
        <clinical/conditions.ttl> ,
        <clinical/medications.ttl> ,
        <clinical/allergies.ttl> ,
        <clinical/lab-results.ttl> ,
        <clinical/immunizations.ttl> ,
        <clinical/vital-signs.ttl> ,
        <clinical/insurance.ttl> ,

    # ── Wellness Records (device + self-reported provenance) ───────────────
        <wellness/heart-rate.ttl> ,
        <wellness/blood-pressure.ttl> ,
        <wellness/activity.ttl> ,
        <wellness/sleep.ttl> ,
        <wellness/supplements.ttl> ,

    # ── Metadata ──────────────────────────────────────────────────────────
        <manifest.ttl> .
